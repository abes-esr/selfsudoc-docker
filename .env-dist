#
# Ci-dessous les variables pour configurer les conteneurs de selfsudoc-docker
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#

######################################################
# Paramètres globaux
######################################################
MEM_LIMIT=4g
CPU_LIMIT=1

SELFSUDOC_BATCH_VERSION=develop-batch
SELFSUDOC_WEB_VERSION=develop-front

######################################################
# Paramétrage des selfsudoc-batch
######################################################
SELFSUDOC_BATCH_TECHNIC_RENDER_JAVA_OPTIONS="-Djava.security.egd=file:///dev/urandom -Xmx1600m -Djaxp.debug=1 -Djavax.xml.parsers.SAXParserFactory=org.apache.xerces.jaxp.SAXParserFactoryImpl -Djavax.xml.transform.TransformerFactory=net.sf.saxon.TransformerFactoryImpl -Dlog4j.configuration=file:/conf/log4j.xml"
SELFSUDOC_BATCH_EXTRACT_JAVA_OPTIONS="-Dfile.encoding=UTF-8 -Dlog4j.configuration=file:/conf/log4j.xml -Djdbc.drivers=oracle.jdbc.driver.OracleDriver"

SELFSUDOC_BATCH_PATH_LIBS_EXT="./volumes/libs"
SELFSUDOC_BATCH_PATH_CONF="./volumes/conf"
SELFSUDOC_BATCH_TECHNIC_RENDER_PATH_DOCBASE="/applis/selfSudoc"

######################################################
# Paramétrage des selfsudoc-web-front
######################################################
SELFSUDOC_WEB_PATH_CONTEXT_MAIN=./volumes/web/context-main.xml
SELFSUDOC_WEB_PATH_CONTEXT_FILEDOWNLOAD=./volumes/web/context-filedownload.xml
SELFSUDOC_WEB_PORT=8080


######################################################
# Paramétrage de selfsudoc-watchtower
######################################################
# Pour les notifications slack des déploiements continus de selfsudoc
# cf https://containrrr.dev/watchtower/notifications/#slack
# A noter : penser à indiquer le nom de l'environnement dev, test, prod
# au niveau de la variable WATCHTOWER_NOTIFICATION_SLACK_IDENTIFIER pour pouvoir
# mieux distinguer sur quel machine a été réalisé le déploiement
# - en local laisser SELFSUDOC_WATCHTOWER_RUN_ONCE=true
# - en dev, test, prod, positionner SELFSUDOC_WATCHTOWER_RUN_ONCE=false
SELFSUDOC_WATCHTOWER_NOTIFICATION_SLACK_HOOK_URL=https://hooks.slack.com/services/XXXXXXX/YYYYYYYYYYY/ZZZZZZZZZZZZZZZZZZZZZZZZ
SELFSUDOC_WATCHTOWER_NOTIFICATION_SLACK_IDENTIFIER=localhost selfsudoc-watchtower
SELFSUDOC_WATCHTOWER_RUN_ONCE=true
